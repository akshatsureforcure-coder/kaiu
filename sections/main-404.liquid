<section class="section error-404 page-width">
  <p class="section-heading__eyebrow reveal">Error 404</p>
  <h1 class="error-404__heading reveal">This page has wandered off</h1>
  <p class="error-404__text reveal">The page you're looking for doesn't exist. Let's get you back to the collection.</p>
  <a href="{{ routes.root_url }}" class="btn btn--primary reveal">Return Home</a>
</section>

{% schema %}
{
  "name": "404 page"
}
{% endschema %}
