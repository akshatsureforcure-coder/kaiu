<div class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-toggle></div>
  <div class="cart-drawer__panel" role="dialog" aria-label="Cart">
    <div class="cart-drawer__header">
      <p class="cart-drawer__title">Your Selection ({{ cart.item_count }})</p>
      <button class="header-icon-btn" data-cart-toggle aria-label="Close cart">{% render 'icon-close' %}</button>
    </div>

    <div class="cart-drawer__body" data-cart-items>
      {% if cart.item_count == 0 %}
        <p class="cart-drawer__empty">Your selection is currently empty.</p>
      {% else %}
        {% for item in cart.items %}
          <div class="cart-line" data-cart-line data-key="{{ item.key }}">
            <a href="{{ item.url }}" class="cart-line__image">
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" loading="lazy">
            </a>
            <div class="cart-line__details">
              <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
              {% unless item.variant.title == 'Default Title' %}
                <p class="cart-line__variant">{{ item.variant.title }}</p>
              {% endunless %}
              <div class="cart-line__qty">
                <button data-qty-decrease aria-label="Decrease quantity">&minus;</button>
                <span data-qty-value>{{ item.quantity }}</span>
                <button data-qty-increase aria-label="Increase quantity">&plus;</button>
              </div>
            </div>
            <div class="cart-line__price-remove">
              <p class="cart-line__price">{{ item.final_line_price | money }}</p>
              <button class="cart-line__remove" data-cart-remove aria-label="Remove">{% render 'icon-close' %}</button>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
    <div class="cart-drawer__footer">
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <span data-cart-subtotal>{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-drawer__note">Shipping and taxes calculated at checkout.</p>
      <a href="{{ routes.cart_url }}" class="btn btn--outline btn--full">View selection</a>
      <a href="{{ routes.cart_url }}/checkout" class="btn btn--primary btn--full">Checkout</a>
    </div>
    {% endif %}
  </div>
</div>
