<section class="section brand-story {% if section.settings.image_position == 'right' %}brand-story--reverse{% endif %}">
  <div class="page-width brand-story__grid">
    <div class="brand-story__media reveal">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
      {% else %}
        <div class="brand-story__placeholder"></div>
      {% endif %}
    </div>
    <div class="brand-story__content reveal">
      {% if section.settings.eyebrow != blank %}
        <p class="section-heading__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="brand-story__heading">{{ section.settings.heading }}</h2>
      <div class="brand-story__text">{{ section.settings.text }}</div>
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_url }}" class="btn btn--outline">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Craft" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Grain by grain, by hand" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every KAIU piece begins as raw timber, seasoned for months before it ever meets a blade. Our artisans shape, sand, and oil each tool by hand — no two grains are alike, and neither are the pieces they become.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our Story" },
    { "type": "url", "id": "button_url", "label": "Button link", "default": "/pages/our-story" }
  ],
  "presets": [
    { "name": "Brand story" }
  ]
}
{% endschema %}
