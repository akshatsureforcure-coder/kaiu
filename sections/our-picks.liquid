<section class="section our-picks page-width">
  <div class="section-heading section-heading--center">
    {% if section.settings.eyebrow != blank %}
      <p class="section-heading__eyebrow reveal">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="section-heading__title reveal">{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}
      <div class="our-picks__intro reveal">{{ section.settings.text }}</div>
    {% endif %}
  </div>

  {% assign picks = section.blocks | where: 'type', 'product' %}
  {% if picks.size > 0 %}
    <div class="product-grid product-grid--4">
      {% for block in picks %}
        {% if block.settings.product != blank %}
          <div class="reveal" {{ block.shopify_attributes }}>
            {% render 'product-card', product: block.settings.product %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <p class="our-picks__empty">Nothing curated here yet — check back soon.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Our Picks",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Picks" },
    { "type": "richtext", "id": "text", "label": "Intro text", "default": "<p>A rotating edit of the pieces we're reaching for right now — chosen by the studio, added one at a time.</p>" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ]
}
{% endschema %}
