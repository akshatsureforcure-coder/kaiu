<section class="hero" style="--hero-height: {{ section.settings.height }}px;">
  <div class="hero__media">
    {% if section.settings.image %}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="{{ section.settings.image.alt | escape }}"
        loading="eager"
        fetchpriority="high">
    {% else %}
      <img
        src="{{ 'kaiu-hero.jpg' | asset_url }}"
        alt="{{ shop.name }} — handcrafted in the workshop"
        loading="eager"
        fetchpriority="high">
    {% endif %}
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__content page-width">
    {% if section.settings.eyebrow != blank %}
      <p class="hero__eyebrow reveal">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="hero__heading reveal">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="hero__subheading reveal">{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_url }}" class="btn btn--primary reveal">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>

  <div class="hero__scroll-cue" aria-hidden="true">
    <span></span>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "height", "min": 400, "max": 900, "step": 20, "unit": "px", "label": "Height", "default": 720 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Handcrafted in small batches" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Art of the Pour" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Wooden bar tools shaped by hand, finished for a lifetime at the table." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the Collection" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
