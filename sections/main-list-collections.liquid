<section class="section collection-listing page-width">
  <div class="section-heading">
    <p class="section-heading__eyebrow reveal">Browse</p>
    <h1 class="section-heading__title reveal">All Collections</h1>
  </div>
  <div class="product-grid product-grid--3">
    {% for collection in collections %}
      {% if collection.handle != 'frontpage' or collections.size == 1 %}
        <a href="{{ collection.url }}" class="collection-card reveal">
          <div class="collection-card__image-wrap">
            {% if collection.featured_image %}
              <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" loading="lazy">
            {% else %}
              <div class="product-card__placeholder"></div>
            {% endif %}
          </div>
          <p class="collection-card__title">{{ collection.title }}</p>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collections list"
}
{% endschema %}
