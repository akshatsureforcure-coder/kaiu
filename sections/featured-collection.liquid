<section class="section featured-collection">
  <div class="page-width">
    <div class="section-heading">
      {% if section.settings.eyebrow != blank %}
        <p class="section-heading__eyebrow reveal">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="section-heading__title reveal">{{ section.settings.heading }}</h2>
      {% if section.settings.link_label != blank %}
        <a href="{{ section.settings.link_url | default: section.settings.collection.url }}" class="section-heading__link reveal">
          {{ section.settings.link_label }} {% render 'icon-arrow' %}
        </a>
      {% endif %}
    </div>

    <div class="product-grid product-grid--{{ section.settings.columns }}">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          <div class="reveal">{% render 'product-card', product: product %}</div>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="product-card reveal">
            <div class="product-card__image-wrap product-card__image-wrap--square">
              <div class="product-card__placeholder"></div>
            </div>
            <div class="product-card__info">
              <p class="product-card__title">Sample Product</p>
              <p class="product-card__price">$0.00</p>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Signature Pieces" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ], "default": "4" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
