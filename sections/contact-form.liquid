<section class="section contact-page page-width">
  <div class="contact-page__grid">
    <div class="contact-page__info reveal">
      <p class="section-heading__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="contact-page__heading">{{ section.settings.heading }}</h1>
      <div class="contact-page__text">{{ section.settings.text }}</div>

      {% if section.settings.email != blank %}
        <p class="contact-page__detail"><span>Email</span><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
      {% endif %}
      {% if section.settings.hours != blank %}
        <p class="contact-page__detail"><span>Hours</span>{{ section.settings.hours }}</p>
      {% endif %}
    </div>

    <div class="contact-page__form reveal">
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <p class="form-success">Thank you — we'll be in touch within two business days.</p>
        {% else %}
          {% if form.errors %}
            <p class="form-error">Please check the fields below and try again.</p>
          {% endif %}
          <div class="form-field">
            <label for="ContactName">Name</label>
            <input type="text" id="ContactName" name="contact[name]" required>
          </div>
          <div class="form-field">
            <label for="ContactEmail">Email</label>
            <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" required>
          </div>
          <div class="form-field">
            <label for="ContactMessage">Message</label>
            <textarea id="ContactMessage" name="contact[body]" rows="5" required></textarea>
          </div>
          <button type="submit" class="btn btn--primary">Send Message</button>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in Touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We'd love to hear from you" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>For order questions, custom requests, or anything else — reach out and a member of our studio will get back to you within two business days.</p>" },
    { "type": "text", "id": "email", "label": "Email", "default": "customercare@kaiu.in" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Monday–Saturday, 10am–6pm IST" }
  ]
}
{% endschema %}
