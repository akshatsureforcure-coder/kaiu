<div class="password-page">
  <div class="password-page__inner">
    <img src="{{ 'kaiu-logo-header.png' | asset_url }}" alt="{{ shop.name }}" class="password-page__logo">

    <p class="section-heading__eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="password-page__heading">{{ section.settings.heading }}</h1>
    <div class="password-page__text">{{ section.settings.text }}</div>

    {% form 'storefront_password' %}
      {% if form.errors %}
        <p class="form-error">Incorrect password — please try again.</p>
      {% endif %}
      <div class="form-field">
        <label for="Password">Password</label>
        <input type="password" id="Password" name="password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--full">Enter</button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Opening Soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "KAIU" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We're putting the finishing touches on the atelier. Enter the password to take an early look.</p>" }
  ]
}
{% endschema %}
