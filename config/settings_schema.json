  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings — Cormorant Garamond"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading size scale",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body — DM Sans"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body size scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1440
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 40,
        "max": 160,
        "step": 10,
        "unit": "px",
        "label": "Space between sections",
        "default": 120
      }
